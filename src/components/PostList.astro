---
import type { Post } from '../lib/posts';
import { formatDate } from '../lib/posts';
import { url } from '../consts';

interface Props { posts: Post[] }
const { posts } = Astro.props;
---
<ul class="posts">
  {posts.map((post) => (
    <li>
      <a href={url(`blog/${post.id}/`)}>
        <h2>{post.data.title}{post.data.draft && <span class="muted"> (draft)</span>}</h2>
      </a>
      <time class="muted" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <p>{post.data.description}</p>
    </li>
  ))}
</ul>

<style>
  .posts { list-style: none; padding: 0; margin: 0; }
  li { margin-bottom: 2.25rem; }
  li a { text-decoration: none; color: inherit; }
  li a:hover h2 { color: var(--accent); }
  h2 { margin: 0 0 0.2rem; font-size: 1.3rem; }
  time { font-size: 0.9rem; }
  p { margin: 0.35rem 0 0; }
</style>
