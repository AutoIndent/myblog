---
import { byYear, formatDate, readingTime, type Post } from '../lib/posts';
import { url } from '../consts';

interface Props { posts: Post[]; group?: boolean }
const { posts, group = true } = Astro.props;
const groups = group ? byYear(posts) : [[null, posts] as const];
---
<div class="post-index">
  {groups.map(([year, list]) => (
    <section class="post-year">
      {year && <h2 class="post-year__label">{year}</h2>}
      <ol class="post-list">
        {list.map((post) => (
          <li class="post-item">
            <time class="post-item__date" datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate, group ? 'short' : 'long')}
            </time>
            <div class="post-item__body">
              <h3 class="post-item__title">
                <a href={url(`blog/${post.id}/`)}>{post.data.title}</a>
                {post.data.draft && <span class="badge">Draft</span>}
              </h3>
              <p class="post-item__desc">{post.data.description}</p>
              <p class="post-item__meta">
                <span>{readingTime(post.body)}</span>
                {post.data.tags.map((t) => <a class="tag" href={url(`tags/${t}/`)}>{t}</a>)}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}
</div>
