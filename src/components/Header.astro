---
import { SITE_TITLE, SITE_TAGLINE, url } from '../consts';

const links = [
  { href: url('/'), label: 'Writing', match: (p: string) => p === url('/') || p.startsWith(url('blog')) },
  { href: url('tags/'), label: 'Topics', match: (p: string) => p.startsWith(url('tags')) },
  { href: url('about/'), label: 'About', match: (p: string) => p.startsWith(url('about')) },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap wide site-header__inner">
    <div class="masthead">
      <a class="site-title" href={url('/')}>{SITE_TITLE}</a>
      <p class="site-tagline">{SITE_TAGLINE}</p>
    </div>
    <nav class="site-nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={l.match(path) ? 'page' : undefined}>{l.label}</a>
      ))}
      <a href={url('rss.xml')} class="rss" title="RSS feed">RSS</a>
    </nav>
  </div>
</header>
