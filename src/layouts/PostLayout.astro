---
import BaseLayout from './BaseLayout.astro';
import { formatDate, readingTime, type Post } from '../lib/posts';
import { url } from '../consts';

interface Props { post: Post }
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
---
<BaseLayout title={title} description={description} type="article">
  <article>
    <header>
      <h1>{title}</h1>
      <p class="muted meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <>{' · updated '}<time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></>}
        {' · '}{readingTime(post.body)}
      </p>
      {tags.length > 0 && (
        <p class="tags">{tags.map((t) => <a class="tag" href={url(`tags/${t}/`)}>#{t}</a>)}</p>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
  <p><a href={url('/')}>← All posts</a></p>
</BaseLayout>

<style>
  article header { margin-bottom: 2.5rem; }
  .meta { margin: 0 0 0.6rem; font-size: 0.95rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; }
  .prose :global(h2:first-child) { margin-top: 0; }
</style>
