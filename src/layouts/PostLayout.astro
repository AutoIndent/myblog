---
import type { MarkdownHeading } from 'astro';
import { Image, getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Toc from '../components/Toc.astro';
import { formatDate, readingTime, type Post } from '../lib/posts';
import { AUTHOR, url } from '../consts';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  prev?: Post;
  next?: Post;
}
const { post, headings, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover } = post.data;
const ogImage = cover
  ? new URL((await getImage({ src: cover.image, width: 1200, format: 'jpeg' })).src, Astro.site).href
  : undefined;
---
<BaseLayout title={title} description={description} type="article" image={ogImage} wide>
  <article class="post">
    <header class="post__header">
      {tags.length > 0 && (
        <p class="post__kicker">
          {tags.map((t, i) => <>{i > 0 && ' · '}<a href={url(`tags/${t}/`)}>{t}</a></>)}
        </p>
      )}
      <h1 class="post__title">{title}</h1>
      <p class="post__dek">{description}</p>
      <p class="post__meta">
        <span>By {AUTHOR}</span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <span>Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>}
        <span>{readingTime(post.body)}</span>
      </p>
    </header>

    {cover && (
      <figure class="post__cover figure">
        <Image
          src={cover.image}
          alt={cover.alt}
          widths={[640, 1000, 1400, 2000]}
          sizes="(min-width: 72rem) 69.5rem, 100vw"
          loading="eager"
          fetchpriority="high"
        />
        {(cover.caption || cover.credit) && (
          <figcaption>
            {cover.caption && <span class="figure__caption">{cover.caption}</span>}
            {cover.credit && (
              <span class="figure__credit">
                Photo: {cover.source ? <a href={cover.source}>{cover.credit}</a> : cover.credit}
                {cover.license && <>, {cover.licenseUrl ? <a href={cover.licenseUrl}>{cover.license}</a> : cover.license}</>}
              </span>
            )}
          </figcaption>
        )}
      </figure>
    )}

    <div class="post__grid">
      <aside class="post__aside">
        <Toc headings={headings} />
      </aside>
      <div class="prose">
        <slot />
      </div>
    </div>

    <nav class="post-nav" aria-label="More posts">
      {next ? (
        <a class="post-nav__link" href={url(`blog/${next.id}/`)}>
          <span class="post-nav__label">Newer</span>
          <span class="post-nav__title">{next.data.title}</span>
        </a>
      ) : <span />}
      {prev && (
        <a class="post-nav__link post-nav__link--prev" href={url(`blog/${prev.id}/`)}>
          <span class="post-nav__label">Older</span>
          <span class="post-nav__title">{prev.data.title}</span>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>
